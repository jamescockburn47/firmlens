# Create a separate development database/auth service. Never copy production secrets.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-HOST/neondb/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
OWNER_EMAIL=owner@example.test
OWNER_USER_ID=PIN_THE_VERIFIED_OWNER_SUBJECT
APP_ORIGIN=https://YOUR-DEPLOYMENT-HOST
# Keep this URL stable when changing the public website domain after OAuth consent.
MCP_RESOURCE_URL=https://YOUR-DEPLOYMENT-HOST/mcp
